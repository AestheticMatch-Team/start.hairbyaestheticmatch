# Main hair backend (API + auth rewrites). Production:
HAIR_BACKEND_ORIGIN=https://hairbyaestheticmatch.com
# Local: affiliate on :3000, main app on :3001 (http; next.config maps hair.localhost → 127.0.0.1):
# HAIR_BACKEND_ORIGIN=http://hair.localhost:3001

# Affiliate channel (Monday status + Stripe metadata _*)
NEXT_PUBLIC_AFFILIATE_PARTNER=start

# This deploy’s public URL (OG, metadata)
# NEXT_PUBLIC_LANDER_ORIGIN=https://start.hairbyaestheticmatch.com
NEXT_PUBLIC_LANDER_ORIGIN=http://localhost:3000

# Supabase auth (public keys — copy from aestheticmatchfinal; required for lander logout UI)
NEXT_PUBLIC_MESSAGING_APP_SUPABASE_URL=
NEXT_PUBLIC_MESSAGING_APP_SUPABASE_ANON_KEY=

# Stripe Elements (publishable key only — checkout API is on the backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pre-quiz Q6 city autocomplete 
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (production/staging when NEXT_PUBLIC_ENVIRONMENT is set)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_AMPLITUDE_KEY=
NEXT_PUBLIC_ENVIRONMENT=dev
